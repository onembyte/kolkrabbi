{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kolkrabbi.francomichetti.com/spec/0/schemas/events/subagent.finished.json",
  "title": "subagent.finished payload",
  "type": "object",
  "required": ["id", "child_turn", "mode", "ok"],
  "properties": {
    "id": {"type": "string", "pattern": "^k_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "child_turn": {"type": "string", "pattern": "^t_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "mode": {"type": "string", "minLength": 1},
    "ok": {"type": "boolean"}
  },
  "additionalProperties": true
}
