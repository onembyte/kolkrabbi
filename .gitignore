# built binaries
/kolk
/kolkd
/kolk-mock

# go workspace files are developer-local by design (see docs/plan/02-architecture.md)
/go.work
/go.work.sum

# test + build artifacts
*.test
/dist/

# dashboard SPA build inputs
/web/dash/node_modules

# Builds
dist/
build/
# local Go + golangci-lint caches. NOT covered by 'build/' -- the leading dot matters
.build/
bin/
obj/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log

# Temporary/cache
.cache/
tmp/

# IDE
.vscode/
.idea/

# Research notes are ours, not the project's. They are working material —
# source reads of other agents, provider docs, vendor comparisons — kept out of
# the published repository deliberately. The plan's "Inputs:" lines still name
# them, and those links are meant to resolve on a maintainer's machine and
# nowhere else.
docs/research/

# Session state a test wrote through an unset app.dirs: never source.
internal/cli/sessions/

# Go tooling output. Coverage and profile files are written into whatever
# directory the command ran in, which is usually a package directory inside
# internal/ — `go test -coverprofile` and `go test -cpuprofile` both do it, and
# the F5 efficiency work produces them by the handful.
*.out
*.prof
*.pprof
*.mem

# Patch and merge leftovers. `git add -A` after a conflict is how a .orig file
# gets committed, and it is never wanted.
*.orig
*.rej

# Editor scratch and OS metadata. .DS_Store matters here: this project ships
# macOS builds, so a maintainer on a Mac creates them by opening a folder.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.#*
\#*#

# Coding-agent local state. This repository is built by more than one agent at
# a time (AGENTS.md), and each keeps machine-local settings — permissions
# granted on this machine, local overrides — that are nobody else's business.
# Shared agent definitions are NOT ignored: only the files whose names say they
# are local.
.claude/settings.local.json
.claude/*.local.json
.cursor/
.aider*
